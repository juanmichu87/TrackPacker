# Copia este archivo como .env y rellena los valores (el .env no se sube a Git).
# Project Settings → Data API → Project URL
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
# Project Settings → API Keys → Publishable key (nunca la secret / service_role)
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx
# Dominio interno del email de los usuarios (el mismo que en los scripts SQL)
AUTH_DOMINIO=<dominio-interno>
