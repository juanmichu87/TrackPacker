# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# =============================================================================
# Archivos sensibles: claves, certificados, firmas y configuración local.
# NUNCA deben subirse al repositorio.
# =============================================================================

# Variables de entorno con claves (solo se sube la plantilla .env.example)
.env
.env.*
*.env
!.env.example

# Certificados y claves privadas (HTTPS local, firmas, APIs)
/.certs/
*.pem
*.key
*.crt
*.cer
*.csr
*.p8
*.p12
*.pfx

# Firma de apps: Android (keystore) e iOS (perfiles y certificados)
key.properties
**/*.keystore
**/*.jks
*.mobileprovision
*.provisionprofile

# Servicios externos (Firebase, Google, despliegues)
google-services.json
GoogleService-Info.plist
.netlify/
.vercel/

# Supabase: base de datos (migraciones, scripts SQL, datos de prueba y
# funciones). Se guarda solo en local, no se sube al repositorio.
supabase/

# Scripts o copias con datos reales (contraseñas, volcados de la base de datos)
*.local.*
*.secret.*
*.dump
*.backup
*.sql.gz

# Configuración local del asistente (rutas de este equipo)
.claude/
